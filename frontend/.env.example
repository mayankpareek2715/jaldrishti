# JalDrishti Frontend Environment Variables

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> Create Credentials -> OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:3000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Optional: Google Maps API Key for Maps & Street View
VITE_GOOGLE_MAPS_API_KEY=

# Backend API URL (default: http://localhost:8080/api)
VITE_API_BASE_URL=http://localhost:8080/api
